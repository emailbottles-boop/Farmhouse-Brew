rules_version = '2';

// Farmhouse Brew — Firestore security rules
//
// Admin access is decided by EMAIL, checked two independent ways:
//   1. A bootstrap owner email hard-coded below. This works even against an
//      empty database, so nobody can ever be fully locked out.
//   2. A document in /adminEmails whose DOCUMENT ID is the email address
//      itself. This is the everyday way to add or remove an admin: no rules
//      edit, no republish, effective immediately.
//
// Deliberately NOT used: the Auth UID. A UID is 28 random characters that
// look alike in the Console font (l/1/I, O/0), get truncated in the user
// list, and are regenerated if the account is ever deleted and recreated.
// A UID-keyed document that's wrong still looks correct — there's no error
// to explain why access failed. Email doesn't have that failure mode.
//
// REPLACE-BEFORE-LAUNCH: the address below is a placeholder. Do not commit
// the real owner email to this file in a public repo — set it via the
// chat-only copy provided separately, pasted straight into the Firebase
// Console's Rules editor.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'owner@example.com' ||
        exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
      );
    }

    // ---- adminEmails: allowlist of additional admins ----
    // Document ID IS the email address, e.g. adminEmails/jane@shop.com
    // Only existing admins may add/remove entries.
    match /adminEmails/{email} {
      allow read, write: if isAdmin();
    }

    // ---- adminProfile: existence-ping used by the dashboard ----
    // The dashboard tries to read its own uid doc. Success (even if the
    // doc doesn't exist) means "authorized." permission-denied means
    // "not authorized." Any other error means "could not determine" —
    // the dashboard is built to tell those three states apart.
    match /adminProfile/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && isAdmin();
    }

    // ---- menu: drink/price list ----
    // photo is an optional data URL (Firebase Storage is off-limits on the
    // Spark plan, so photos are compressed client-side and stored inline).
    // Capped well under Firestore's 1 MB document limit as a backstop —
    // the admin UI already compresses before it ever gets this far.
    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
      allow delete: if isAdmin();
    }

    // ---- site/hours, site/banner: single-document settings ----
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- inquiries: public contact form ----
    // World-writable by design (that's the point of a contact form), so
    // every field is validated and no extra fields can be smuggled in.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'phone', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }
  }
}
